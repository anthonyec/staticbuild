{
  "name": "@anthonyec/staticbuild",
  "version": "3.0.4",
  "description": "Static site generator that isn't for you",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonyec/staticbuild.git"
  },
  "bin": {
    "staticbuild": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "npm run copy && tsc",
    "debug": "npm run copy && tsc --watch",
    "copy": "node ./scripts/copy_partials.mjs",
    "test": "echo 'No tests yet, so everything is a-OK!'",
    "format": "prettier --loglevel warn --write \"**/*.{md,ts}\""
  },
  "author": "Anthony Cossins",
  "license": "ISC",
  "dependencies": {
    "markdown-wasm": "^1.2.0",
    "mustache": "^4.2.0",
    "node-html-parser": "^7.0.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/mustache": "^4.1.2",
    "@types/node": "^25.3.3",
    "prettier": "^2.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
